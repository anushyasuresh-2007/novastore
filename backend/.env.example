FLASK_ENV=development

# Production Secret Key Configuration:
# In production, SECRET_KEY must be a unique, cryptographically random string of at least 32 characters.
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
# Application startup will strictly fail in production if SECRET_KEY is missing, equals the development fallback,
# or is shorter than 32 characters.
SECRET_KEY=change-this-to-a-secure-random-key-in-production

DATABASE_URL=sqlite:///instance/store.db

# CORS Configuration:
# In development: defaults to local frontend servers (http://localhost:5173,http://127.0.0.1:5173).
# In production: MUST be explicitly set to comma-separated allowed origins (e.g., https://your-domain.com,https://admin.your-domain.com).
# Wildcard origins ('*') are strictly rejected during production startup.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Configuration (sliding window per client IP):
RATELIMIT_ENABLED=True
RATELIMIT_ADMIN_LOGIN_LIMIT=5
RATELIMIT_ADMIN_LOGIN_PERIOD=60
RATELIMIT_ORDER_CREATE_LIMIT=10
RATELIMIT_ORDER_CREATE_PERIOD=60

# Reverse Proxy Configuration:
# Set to the exact count of trusted reverse proxies in front of the application (e.g., 1 for Nginx, AWS ALB, or Cloudflare).
# Defaults to 0 (direct connection). When 0, X-Forwarded-For headers are ignored to prevent client IP spoofing.
TRUSTED_PROXIES_COUNT=0

# Admin Session Security:
# Administrator tokens expire 2 hours (7200 seconds) after issuance.
# Password changes automatically revoke all existing session tokens.

PORT=5000

# Administrator Credentials Template
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Admin password policy: minimum 8 characters required.
ADMIN_PASSWORD=change-to-a-strong-password
